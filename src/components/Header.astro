---
import { navLinks } from "../data/site";
---

<header class="site-header">
    <div class="container site-header__inner">
        <a class="brand" href="/">
            <img
                class="brand__logo"
                src="/fosrtechLogo.svg"
                width="785"
                height="163"
                alt="FOSR Tech home"
            />
        </a>
        <button
            class="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav"
        >
            Menu
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Primary">
            <ul>
                {navLinks.map((link) => (
                    <li>
                        <a href={link.href}>{link.label}</a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</header>
